#include <stdint.h>
#include <stdio.h>
#include <unistd.h>
#include "system.h"
#include "io.h"

unsigned char SEG_MAP[10] =
{
    0x40, // 0 -> ~0x3F
    0x79, // 1 -> ~0x06
    0x24, // 2 -> ~0x5B
    0x30, // 3 -> ~0x4F
    0x19, // 4 -> ~0x66
    0x12, // 5 -> ~0x6D
    0x02, // 6 -> ~0x7D
    0x78, // 7 -> ~0x07
    0x00, // 8 -> ~0x7F
    0x10  // 9 -> ~0x6F
};

// Função para escrever nos 7 segmentos
void write_sevenseg(int dist)
{
    int d0 = dist % 10;
    int d1 = (dist / 10) % 10;
    int d2 = (dist / 100) % 10;
    int d3 = (dist / 1000) % 10;

    int packed = (SEG_MAP[d0] << 0) | (SEG_MAP[d1] << 8) | (SEG_MAP[d2] << 16) | (SEG_MAP[d3] << 24);
    IOWR_32DIRECT(SEVEN_SEG_BASE, 0, packed);
}

int main()
{
    printf("==== Telemetre Ultrasonique DE10-Lite ====\n");

    while (1)
    {
        // Ler distância da IP Avalon
        int dist = IORD_32DIRECT(TELEMETRE_US_AVALON_0_BASE, 0);

        if (dist > 9999) dist = 9999;
        if (dist < 0) dist = 0;

        // Mostrar no terminal
        printf("Distance: %d cm\n", dist);

        // Mostrar no display de 7 segmentos
        write_sevenseg(dist);

        usleep(50000); // 20 Hz
    }

    return 0;
}



