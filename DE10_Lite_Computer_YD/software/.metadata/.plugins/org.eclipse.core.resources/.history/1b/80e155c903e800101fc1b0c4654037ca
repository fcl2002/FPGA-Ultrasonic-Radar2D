/*
 * RADAR SYSTEM - DE10-Lite
 * Integrado para Intel FPGA Monitor Program
 */

#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include "io.h"
#include "system.h"
#include "unistd.h" // Para usleep()

// Bibliotecas Oficiais de Vídeo da Altera / Intel University Program
// O Monitor Program encontra esses arquivos automaticamente!
#include "altera_up_avalon_video_pixel_buffer_dma.h"
#include "altera_up_avalon_video_character_buffer_with_dma.h"

// ============================================================================
// DEFINIÇÕES DE HARDWARE
// ============================================================================

// Endereços base (Vêm do seu system.h)
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// Parâmetros do Servo e Radar
#define HARDWARE_MIN  60    // ~0 graus
#define HARDWARE_MAX  200   // ~180 graus
#define PI 3.14159265
#define CENTER_X 160
#define CENTER_Y 239

// Cores (Formato 16-bit RGB 565)
#define COLOR_BLACK 0x0000
#define COLOR_WHITE 0xFFFF
#define COLOR_GREEN 0x07E0
#define COLOR_RED   0xF800
#define COLOR_BLUE  0x001F

// Variáveis Globais para os Drivers de Vídeo
alt_up_pixel_buffer_dma_dev* pixel_buffer_dev;
alt_up_char_buffer_dev* char_buffer_dev;

// ============================================================================
// FUNÇÕES AUXILIARES
// ============================================================================

// Inicializa o VGA usando os drivers oficiais
int init_vga() {
    // 1. Abrir o Pixel Buffer (Gráficos)
    // O nome "/dev/..." vem do seu system.h
    pixel_buffer_dev = alt_up_pixel_buffer_dma_open_dev("/dev/VGA_Subsystem_VGA_Pixel_DMA");

    if (pixel_buffer_dev == NULL) {
        printf("ERRO CRITICO: Nao foi possivel abrir o Pixel Buffer DMA.\n");
        return -1;
    }

    // 2. Limpar a tela (fundo preto)
    alt_up_pixel_buffer_dma_clear_screen(pixel_buffer_dev, 0);

    // 3. Abrir o Char Buffer (Texto) - Opcional, mas útil para debug
    char_buffer_dev = alt_up_char_buffer_open_dev("/dev/VGA_Subsystem_Char_Buf_Subsystem_Char_Buf_DMA");
    if (char_buffer_dev == NULL) {
        printf("Aviso: Char Buffer nao encontrado, texto na tela desativado.\n");
    } else {
        alt_up_char_buffer_clear(char_buffer_dev);
        alt_up_char_buffer_string(char_buffer_dev, "SISTEMA RADAR ATIVO", 30, 2);
    }

    printf("VGA Inicializado com Sucesso!\n");
    return 0;
}

// Mapeia valor 0-255 para o PWM do servo
int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

// Desenha uma linha (Wrapper para a função da biblioteca)
void draw_line(int x0, int y0, int x1, int y1, int color) {
    alt_up_pixel_buffer_dma_draw_line(pixel_buffer_dev, x0, y0, x1, y1, color, 0);
}

// Desenha um pixel (Wrapper)
void plot_pixel(int x, int y, int color) {
    alt_up_pixel_buffer_dma_draw(pixel_buffer_dev, color, x, y);
}

// ============================================================================
// MAIN
// ============================================================================
int main(void) {
    printf("--- INICIANDO RADAR ---\n");

    // 1. Tenta iniciar o vídeo. Se falhar, sai.
    if (init_vga() != 0) {
        return -1;
    }

    // 2. Desenha bordas de teste para garantir que a tela está ligada
    draw_line(0, 0, 319, 0, COLOR_WHITE);
    draw_line(0, 0, 0, 239, COLOR_WHITE);
    draw_line(319, 0, 319, 239, COLOR_WHITE);
    draw_line(0, 239, 319, 239, COLOR_WHITE);

    // Variáveis de controle do Radar
    int pos_virtual = 0;   // 0 a 255
    int direcao = 1;       // +1 ou -1
    int prev_scan_x = CENTER_X;
    int prev_scan_y = CENTER_Y;

    // String temporária para texto
    char msg[20];

    while (1) {
        // --- A. APAGA A LINHA ANTERIOR ---
        // Desenha preto sobre a linha antiga
        draw_line(CENTER_X, CENTER_Y, prev_scan_x, prev_scan_y, COLOR_BLACK);

        // --- B. MOVE O SERVO ---
        int pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);
        usleep(15000); // Espera 15ms para o motor chegar na posição

        // --- C. LÊ O SENSOR ULTRASSOM ---
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF; // Máscara para pegar os 10 bits

        // Limita a distância visual a 100cm para caber na tela
        if (dist_cm > 100) dist_cm = 100;

        // --- D. CÁLCULOS MATEMÁTICOS ---
        // Converte 0-255 para radianos (0 a PI)
        float angulo_rad = ((float)pos_virtual / 255.0) * PI;

        // Coordenadas da linha de varredura (Radar Scanner)
        int scan_len = 200; // Comprimento da linha verde
        int scan_x = CENTER_X - (int)(scan_len * cos(angulo_rad));
        int scan_y = CENTER_Y - (int)(scan_len * sin(angulo_rad));

        // Coordenadas do Obstáculo (se existir)
        // Multiplica por 2 para "zoom" (1cm real = 2 pixels na tela)
        int obst_x = CENTER_X - (int)(dist_cm * 2.0 * cos(angulo_rad));
        int obst_y = CENTER_Y - (int)(dist_cm * 2.0 * sin(angulo_rad));

        // --- E. DESENHA ---

        // 1. Linha do Scanner (Verde)
        draw_line(CENTER_X, CENTER_Y, scan_x, scan_y, COLOR_GREEN);

        // 2. Obstáculo (Vermelho) - Se estiver perto (entre 4cm e 95cm)
        if (dist_cm < 95 && dist_cm > 4) {
            // Desenha um ponto "gordo" (quadrado 2x2)
            plot_pixel(obst_x, obst_y, COLOR_RED);
            plot_pixel(obst_x+1, obst_y, COLOR_RED);
            plot_pixel(obst_x, obst_y+1, COLOR_RED);
            plot_pixel(obst_x+1, obst_y+1, COLOR_RED);
        }

        // --- F. ATUALIZA ESTADO ---
        prev_scan_x = scan_x;
        prev_scan_y = scan_y;

        // Mostra distância em texto (opcional) a cada 20 passos para não piscar muito
        if (pos_virtual % 20 == 0 && char_buffer_dev != NULL) {
            sprintf(msg, "Dist: %d cm   ", dist_cm);
            alt_up_char_buffer_string(char_buffer_dev, msg, 2, 58); // Canto inferior esquerdo
        }

        // Move o radar
        pos_virtual += direcao * 3; // Velocidade do varrimento

        // Inverte direção nas pontas
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
