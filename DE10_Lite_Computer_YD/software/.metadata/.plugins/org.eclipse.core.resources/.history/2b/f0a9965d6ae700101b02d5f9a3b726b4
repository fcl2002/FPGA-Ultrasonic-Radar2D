#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include <math.h> // Importante para sin e cos
#include "io.h"
#include "system.h"
#include "altera_up_avalon_video_pixel_buffer_dma.h"
#include "altera_up_avalon_video_character_buffer_with_dma.h"

// --- CONFIGURAÇÕES ---
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// Limites Seguros do Servo (Ajuste se precisar)
#define HARDWARE_MIN  60
#define HARDWARE_MAX  200

// Configuração da Tela (Geralmente 320x240 na DE10-Lite IP)
#define SCREEN_WIDTH  320
#define SCREEN_HEIGHT 240
#define CENTER_X      160 // Meio da tela
#define CENTER_Y      239 // Base da tela

#define PI 3.14159265

// Cores (Formato 16-bit 5-6-5)
#define COLOR_BLACK 0x0000
#define COLOR_GREEN 0x07E0
#define COLOR_RED   0xF800
#define COLOR_BLUE  0x001F

// Função para mapear servo
int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

int main()
{
    alt_putstr("=== INICIANDO RADAR VGA ===\n");

    // 1. INICIALIZAÇÃO DO VÍDEO
    alt_up_pixel_buffer_dma_dev* pixel_buf;
    pixel_buf = alt_up_pixel_buffer_dma_open_dev("/dev/VGA_Subsystem_Char_Buf_Subsystem_Char_Buf_DMA"
");

    if (pixel_buf == NULL) {
        alt_putstr("ERRO: Nao achou o Pixel Buffer (VGA).\n");
        // Se travar aqui, confira o nome no system.h ou Qsys
        // Pode ser "/dev/video_pixel_buffer_dma" sem o _0
    }

    // Limpa a tela (Pinta tudo de preto)
    alt_up_pixel_buffer_dma_clear_screen(pixel_buf, 0);

    // Desenha um "box" azul no fundo só pra saber que a VGA funciona
    alt_up_pixel_buffer_dma_draw_box(pixel_buf, 0, 0, 319, 239, COLOR_BLACK, 0);

    // Variáveis de Controle
    int pos_virtual = 0;
    int direcao = 1;
    int pos_fisica = 0;

    // Para apagar a linha anterior
    int prev_x = CENTER_X;
    int prev_y = CENTER_Y;

    while (1)
    {
        // --- A. APAGAR O DESENHO ANTERIOR ---
        // Desenha uma linha PRETA onde estava a linha verde antiga
        alt_up_pixel_buffer_dma_draw_line(pixel_buf, CENTER_X, CENTER_Y, prev_x, prev_y, COLOR_BLACK, 0);

        // --- B. MOVER SERVO ---
        pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);
        usleep(20000); // 20ms

        // --- C. LER SENSOR ---
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF;
        if (dist_cm > 150) dist_cm = 150; // Limita alcance visual (escala da tela)

        // --- D. CALCULAR GEOMETRIA ---
        // Converte 0-255 para 0-180 graus, depois para Radianos
        // Nota: O servo 0 geralmente é esquerda (180 graus na trigonometria da tela)
        // Ajuste: Angulo = (pos_virtual / 255.0) * PI
        float angulo_rad = ((float)pos_virtual / 255.0) * PI;

        // Calcula ponta da linha (Scanner) - Raio fixo de varredura (ex: 200px)
        int scan_len = 200;
        int scan_x = CENTER_X - (int)(scan_len * cos(angulo_rad)); // Inverti cos pra ajustar lado
        int scan_y = CENTER_Y - (int)(scan_len * sin(angulo_rad));

        // Calcula posição do obstáculo
        int obst_x = CENTER_X - (int)(dist_cm * 1.5 * cos(angulo_rad)); // 1.5 é zoom
        int obst_y = CENTER_Y - (int)(dist_cm * 1.5 * sin(angulo_rad));

        // --- E. DESENHAR NOVO QUADRO ---

        // 1. Desenha a linha do scanner (Verde)
        alt_up_pixel_buffer_dma_draw_line(pixel_buf, CENTER_X, CENTER_Y, scan_x, scan_y, COLOR_GREEN, 0);

        // 2. Se tiver obstáculo perto, desenha ponto (Vermelho)
        if (dist_cm < 100 && dist_cm > 2) {
             // Desenha um quadrado 3x3 para ficar visivel
             alt_up_pixel_buffer_dma_draw_box(pixel_buf, obst_x-2, obst_y-2, obst_x+2, obst_y+2, COLOR_RED, 0);
        }

        // Salva coordenadas para apagar no proximo loop
        prev_x = scan_x;
        prev_y = scan_y;

        // Atualiza Posição
        pos_virtual += direcao * 4; // Velocidade 4
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
