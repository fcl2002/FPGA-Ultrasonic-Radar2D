/*
 * RADAR SYSTEM - DE10-Lite
 * Código Autossuficiente (Não precisa de system.h nem drivers)
 */

#include <stdio.h>
#include <stdlib.h>
#include <math.h>

// ============================================================================
// ENDEREÇOS DE HARDWARE (Copiados do seu system.h)
// ============================================================================

// Definições básicas de I/O para substituir a biblioteca io.h
#define IORD_32DIRECT(BASE, OFFSET) (*((volatile unsigned int *)(BASE + OFFSET)))
#define IOWR_32DIRECT(BASE, OFFSET, DATA) (*((volatile unsigned int *)(BASE + OFFSET)) = (DATA))
#define IOWR_16DIRECT(BASE, OFFSET, DATA) (*((volatile unsigned short *)(BASE + OFFSET)) = (DATA))
#define IORD(BASE, OFFSET) (*((volatile unsigned int *)(BASE + (OFFSET * 4))))
#define IOWR(BASE, OFFSET, DATA) (*((volatile unsigned int *)(BASE + (OFFSET * 4))) = (DATA))

// Endereços dos Periféricos
#define SERVO_BASE      0x04000004
#define TELEMETRE_BASE  0x04000008

// Endereços de Vídeo (VGA)
#define PIXEL_DMA_CTRL  0xFF203020
#define CHAR_BUFFER     0x09000000  // Endereço para escrever texto
#define SDRAM_BASE      0x00000000

// Vamos usar o endereço físico 0x00000000 da SDRAM, mas com o bit 31 ligado (0x80000000)
// para dar "bypass" no cache do processador e escrever direto na RAM.
// Offset de 32MB (0x02000000) para não apagar o programa.
#define VGA_MEMORY      (0x80000000 | (SDRAM_BASE + 0x02000000))

// Cores (16-bit RGB 565)
#define WHITE 0xFFFF
#define BLACK 0x0000
#define GREEN 0x07E0
#define RED   0xF800

// ============================================================================
// FUNÇÕES AUXILIARES
// ============================================================================

// Delay simples (já que não temos unistd.h configurado)
void delay_ms(int ms) {
    int i;
    // Ajuste empírico para Nios II @ 50MHz
    for(i = 0; i < ms * 2500; i++) {
        __asm__ volatile ("nop"); // Instrução vazia para gastar tempo
    }
}

// Inicializa o VGA escrevendo direto nos registradores
void init_vga_manual() {
    // 1. Define o endereço da memória de vídeo (Back Buffer)
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 4, VGA_MEMORY);

    // 2. Define a resolução (320x240)
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 8, (240 << 16) | 320);

    // 3. Reseta e Ativa o DMA
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 12, 0x4); // Reset
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 12, 0x1); // Enable

    // 4. Swap buffer
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 0, 1);

    // Limpa a tela (Pinta de preto)
    for(int i = 0; i < (320 * 240); i++) {
        IOWR_16DIRECT(VGA_MEMORY, i*2, BLACK);
    }
}

void plot_pixel(int x, int y, short color) {
    if (x < 0 || x >= 320 || y < 0 || y >= 240) return;
    int offset = (y * 320 + x) * 2;
    IOWR_16DIRECT(VGA_MEMORY, offset, color);
}

void draw_line(int x0, int y0, int x1, int y1, short color) {
    int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
    int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
    int err = dx + dy, e2;
    while (1) {
        plot_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
    }
}

// ============================================================================
// MAIN
// ============================================================================

#define CENTER_X 160
#define CENTER_Y 239
#define PI 3.14159265

int map_range(int x) {
    // Mapeia 0-255 para 60-200 (pulsos do servo)
    return 60 + (x * (200 - 60) / 255);
}

int main(void) {
    // Se o terminal funcionar, vai aparecer isso. Se não, ignoramos.
    printf("--- RADAR INICIADO (Modo Universal) ---\n");

    init_vga_manual();

    // Desenha bordas brancas
    draw_line(0, 0, 319, 0, WHITE);
    draw_line(0, 0, 0, 239, WHITE);
    draw_line(319, 0, 319, 239, WHITE);

    int pos_virtual = 0;
    int direcao = 1;
    int prev_x = CENTER_X, prev_y = CENTER_Y;

    while (1) {
        // 1. Apaga linha antiga
        draw_line(CENTER_X, CENTER_Y, prev_x, prev_y, BLACK);

        // 2. Move Servo
        int pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);
        delay_ms(15);

        // 3. Lê Sensor
        unsigned int radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF;
        if (dist_cm > 100) dist_cm = 100;

        // 4. Calcula Posição
        float angulo_rad = ((float)pos_virtual / 255.0) * PI;

        int scan_x = CENTER_X - (int)(200 * cos(angulo_rad));
        int scan_y = CENTER_Y - (int)(200 * sin(angulo_rad));

        int obst_x = CENTER_X - (int)(dist_cm * 2.0 * cos(angulo_rad));
        int obst_y = CENTER_Y - (int)(dist_cm * 2.0 * sin(angulo_rad));

        // 5. Desenha
        draw_line(CENTER_X, CENTER_Y, scan_x, scan_y, GREEN);

        if (dist_cm < 95 && dist_cm > 4) {
            plot_pixel(obst_x, obst_y, RED);
            plot_pixel(obst_x+1, obst_y, RED);
            plot_pixel(obst_x, obst_y+1, RED);
            plot_pixel(obst_x+1, obst_y+1, RED);
        }

        prev_x = scan_x;
        prev_y = scan_y;

        // Atualiza loop
        pos_virtual += direcao * 4;
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
