// ==========================================
// CONFIGURAÇÕES DE HARDWARE
// ==========================================
// Endereço base da memória de Vídeo (SDRAM no DE10-Lite começa em 0)
// Se a imagem não aparecer, tente trocar por 0x08000000 (SRAM)
#define PIXEL_BUFFER_BASE 0x00000000

// Endereço base do Buffer de Caracteres
#define CHAR_BUF_BASE VGA_SUBSYSTEM_CHAR_BUF_SUBSYSTEM_ONCHIP_SRAM_BASE

// Definições da Tela
#define SCREEN_WIDTH  320
#define SCREEN_HEIGHT 240
#define CENTER_X      160
#define CENTER_Y      239
#define MAX_RADIUS    220
#define PI            3.14159265

// Cores (RGB 565)
#define COLOR_BLACK 0x0000
#define COLOR_WHITE 0xFFFF
#define COLOR_GREEN 0x07E0
#define COLOR_RED   0xF800

// ==========================================
// FUNÇÕES DE DESENHO (MEMÓRIA DIRETA)
// ==========================================

// Plota um pixel escrevendo diretamente no endereço de memória
// Isso é MUITO mais rápido e evita erros de driver
void plot_pixel(int x, int y, short color) {
    if (x < 0 || x >= SCREEN_WIDTH || y < 0 || y >= SCREEN_HEIGHT) return;

    // O endereço é: Base + (y * largura + x) * 2 bytes
    unsigned int offset = (y * SCREEN_WIDTH + x) << 1;
    IOWR_16DIRECT(PIXEL_BUFFER_BASE, offset, color);
}

// Algoritmo de Bresenham para traçar linhas (Otimizado)
void draw_line_manual(int x0, int y0, int x1, int y1, short color) {
    int dx = abs(x1 - x0);
    int dy = abs(y1 - y0);
    int sx = (x0 < x1) ? 1 : -1;
    int sy = (y0 < y1) ? 1 : -1;
    int err = dx - dy;
    int e2;

    while (1) {
        plot_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        e2 = 2 * err;
        if (e2 > -dy) {
            err -= dy;
            x0 += sx;
        }
        if (e2 < dx) {
            err += dx;
            y0 += sy;
        }
    }
}

// Desenha um quadrado preenchido (para o objeto detectado)
void draw_box_manual(int x, int y, int size, short color) {
    int i, j;
    for(i = x - size; i <= x + size; i++) {
        for(j = y - size; j <= y + size; j++) {
            plot_pixel(i, j, color);
        }
    }
}

// ==========================================
// FUNÇÕES DE TEXTO
// ==========================================
void vga_write_text(int x, int y, char *text_ptr) {
    unsigned int offset = (y << 7) + x; // offset = y*128 + x
    while (*text_ptr) {
        IOWR_8DIRECT(CHAR_BUF_BASE, offset, *text_ptr);
        text_ptr++;
        offset++;
    }
}

void vga_clear_text() {
    int offset;
    for (offset = 0; offset < (80 * 60); offset++) {
        IOWR_8DIRECT(CHAR_BUF_BASE, offset, 0); // 0 = null/espaço
    }
}

