// FUNÇÕES PRINCIPAIS
// ==========================================

void init_vga() {
    printf("Iniciando VGA (Modo: Acesso Direto SDRAM)...\n");

    // 1. Tenta limpar o controlador de DMA (Apenas para garantir o reset)
    // Usamos a função _open apenas para dar reset, mas desenhamos via memória
    alt_up_video_dma_dev *dma_dev = alt_up_video_dma_open_dev("/dev/VGA_Subsystem_VGA_Pixel_DMA");
    if(dma_dev != NULL) {
        alt_up_video_dma_screen_clear(dma_dev, 0);
    }

    // 2. Limpar a memória de vídeo manualmente (Pinta tudo de preto)
    int x, y;
    for(y = 0; y < SCREEN_HEIGHT; y++) {
        for(x = 0; x < SCREEN_WIDTH; x++) {
            plot_pixel(x, y, COLOR_BLACK);
        }
    }

    // 3. Desenhar a Grade do Radar
    // Linha inferior
    draw_line_manual(10, CENTER_Y, 310, CENTER_Y, COLOR_WHITE);

    // Arcos de distância (50, 100, 150 px)
    // Como desenhar círculos é pesado, desenhamos pontos ou linhas curtas
    for (int r = 50; r <= 150; r += 50) {
        for (int ang = 10; ang < 170; ang += 5) {
            int ax = CENTER_X + (int)(r * cos(ang * PI / 180.0));
            int ay = CENTER_Y - (int)(r * sin(ang * PI / 180.0));
            plot_pixel(ax, ay, COLOR_WHITE);
        }
    }

    // 4. Texto Inicial
    vga_clear_text();
    vga_write_text(30, 2, "RADAR DE10-LITE");
    vga_write_text(2, 58, "Status: VARREDURA");
}

