 * Versão V3: Sem dependência de math.h (Resolve erro de linker)
 */

#include <stdio.h>
#include <stdlib.h>
#include "io.h"

// ============================================================================
// ENDEREÇOS DE HARDWARE
// ============================================================================
#define IORD(BASE, OFFSET) (*((volatile unsigned int *)(BASE + (OFFSET * 4))))
#define IOWR(BASE, OFFSET, DATA) (*((volatile unsigned int *)(BASE + (OFFSET * 4))) = (DATA))
#define IOWR_16DIRECT(BASE, OFFSET, DATA) (*((volatile unsigned short *)(BASE + OFFSET)) = (DATA))
#define IOWR_32DIRECT(BASE, OFFSET, DATA) (*((volatile unsigned int *)(BASE + OFFSET)) = (DATA))

#define SERVO_BASE      0x04000004
#define TELEMETRE_BASE  0x04000008
#define PIXEL_DMA_CTRL  0xFF203020
#define SDRAM_BASE      0x00000000
#define VGA_MEMORY      (0x80000000 | (SDRAM_BASE + 0x02000000))

#define WHITE 0xFFFF
#define BLACK 0x0000
#define GREEN 0x07E0
#define RED   0xF800

#define CENTER_X 160
#define CENTER_Y 239

// ============================================================================
// MATEMÁTICA MANUAL (Substitui math.h)
// ============================================================================
// Tabela de Seno de 0 a 180 graus (17 pontos para interpolação)
// Mapeia 0..255 (pos_virtual) -> 0..PI
const float SIN_TABLE[17] = {
    0.0000, 0.1951, 0.3827, 0.5556, 0.7071, 0.8315, 0.9239, 0.9808,
    1.0000, 0.9808, 0.9239, 0.8315, 0.7071, 0.5556, 0.3827, 0.1951, 0.0000
};

const float COS_TABLE[17] = {
    1.0000, 0.9808, 0.9239, 0.8315, 0.7071, 0.5556, 0.3827, 0.1951,
    0.0000, -0.1951, -0.3827, -0.5556, -0.7071, -0.8315, -0.9239, -0.9808, -1.0000
};

// Função personalizada de Seno (Interpolação Linear)
// Entrada x: 0 a 255 (representando 0 a PI)
float meu_sin(int x) {
    if (x < 0) x = 0; if (x > 255) x = 255;
    int index = x >> 4; // Divide por 16 (Pega o índice inteiro 0..16)
    int rem = x & 0x0F; // Resto da divisão (0..15)

    // Pega o valor base e o próximo para interpolar
    float val1 = SIN_TABLE[index];
    float val2 = (index < 16) ? SIN_TABLE[index+1] : val1;

    // Interpolação: val1 + (diferença * porcentagem do resto)
    return val1 + (val2 - val1) * ((float)rem / 16.0f);
}

// Função personalizada de Cosseno
float meu_cos(int x) {
    if (x < 0) x = 0; if (x > 255) x = 255;
    int index = x >> 4;
    int rem = x & 0x0F;
    float val1 = COS_TABLE[index];
    float val2 = (index < 16) ? COS_TABLE[index+1] : val1;
    return val1 + (val2 - val1) * ((float)rem / 16.0f);
}

// ============================================================================
// FUNÇÕES VGA
// ============================================================================
void init_vga_manual() {
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 4, VGA_MEMORY);
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 8, (240 << 16) | 320);
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 12, 0x4); // Reset
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 12, 0x1); // Enable
    IOWR_32DIRECT(PIXEL_DMA_CTRL, 0, 1);    // Swap

    for(int i = 0; i < (320 * 240); i++) {
        IOWR_16DIRECT(VGA_MEMORY, i*2, BLACK);
    }
}

void plot_pixel(int x, int y, short color) {
    if (x < 0 || x >= 320 || y < 0 || y >= 240) return;
    int offset = (y * 320 + x) * 2;
    IOWR_16DIRECT(VGA_MEMORY, offset, color);
}

void draw_line(int x0, int y0, int x1, int y1, short color) {
    int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
    int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
    int err = dx + dy, e2;
    while (1) {
        plot_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
    }
}

void delay_ms(int ms) {
    for(int i = 0; i < ms * 2500; i++) { __asm__ volatile ("nop"); }
}

int map_range(int x) {
    return 60 + (x * (200 - 60) / 255);
}

// ============================================================================
// MAIN
// ============================================================================
int main(void) {
    printf("--- RADAR V3 (Sem math.h) ---\n");

    init_vga_manual();

    // Bordas
    draw_line(0, 0, 319, 0, WHITE);
    draw_line(0, 0, 0, 239, WHITE);
    draw_line(319, 0, 319, 239, WHITE);

    int pos_virtual = 0;
    int direcao = 1;
    int prev_x = CENTER_X, prev_y = CENTER_Y;

    while (1) {
        // 1. Apaga linha antiga
        draw_line(CENTER_X, CENTER_Y, prev_x, prev_y, BLACK);

        // 2. Servo
        IOWR(SERVO_BASE, 0, map_range(pos_virtual));
        delay_ms(10);

        // 3. Lê Sensor
        unsigned int radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF;
        if (dist_cm > 100) dist_cm = 100;

        // 4. Calcula Posição USANDO NOSSA FUNÇÃO (Sem math.h)
        // pos_virtual (0..255) é passado direto para meu_sin/meu_cos

        int scan_len = 200;
        int scan_x = CENTER_X - (int)(scan_len * meu_cos(pos_virtual));
        int scan_y = CENTER_Y - (int)(scan_len * meu_sin(pos_virtual));

        int obst_x = CENTER_X - (int)(dist_cm * 2.0 * meu_cos(pos_virtual));
        int obst_y = CENTER_Y - (int)(dist_cm * 2.0 * meu_sin(pos_virtual));

        // 5. Desenha
        draw_line(CENTER_X, CENTER_Y, scan_x, scan_y, GREEN);

        if (dist_cm < 95 && dist_cm > 4) {
            plot_pixel(obst_x, obst_y, RED);
            plot_pixel(obst_x+1, obst_y, RED);
            plot_pixel(obst_x, obst_y+1, RED);
            plot_pixel(obst_x+1, obst_y+1, RED);
        }

        prev_x = scan_x;
        prev_y = scan_y;

        pos_virtual += direcao * 4;
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
