#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include <math.h>
#include <stdlib.h> // Para abs()
#include "io.h"
#include "system.h"

// ============================================================================
// CONFIGURAÇÕES DE HARDWARE
// ============================================================================
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// ENDEREÇO DA MEMÓRIA DE VÍDEO
// Na DE10-Lite Computer, a imagem da VGA fica no começo da SDRAM.
// Verifique no seu system.h se o nome é SDRAM_BASE ou NEW_SDRAM_CONTROLLER_0_BASE
#ifdef SDRAM_BASE
    #define VGA_MEM_BASE SDRAM_BASE
#else
    #define VGA_MEM_BASE 0xC0000000 // Endereço padrão se não achar o define
#endif

// ============================================================================
// FUNÇÕES GRÁFICAS MANUAIS (SUBSTITUEM A BIBLIOTECA)
// ============================================================================

// Cores 16-bit (R=5bits, G=6bits, B=5bits)
#define WHITE 0xFFFF
#define BLACK 0x0000
#define GREEN 0x07E0 // 00000 111111 00000
#define RED   0xF800 // 11111 000000 00000

// Plota um único pixel na memória
void plot_pixel(int x, int y, short color) {
    if (x < 0 || x >= 320 || y < 0 || y >= 240) return;

    // A memória é linear. Endereço = Base + Offset
    // Offset = (y * largura + x) * tamanho_do_pixel (2 bytes para 16-bit color)
    int offset = (y * 320 + x) * 2;

    // Escreve a cor naquele endereço
    IOWR_16DIRECT(VGA_MEM_BASE, offset, color);
}

// Desenha linha (Algoritmo de Bresenham)
void draw_line(int x0, int y0, int x1, int y1, short color) {
    int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
    int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
    int err = dx + dy, e2;

    while (1) {
        plot_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
    }
}

// Limpa a tela (Pinta tudo de preto)
void clear_screen() {
    for (int y = 0; y < 240; y++) {
        for (int x = 0; x < 320; x++) {
            plot_pixel(x, y, BLACK);
        }
    }
}

// ============================================================================
// MAIN - RADAR
// ============================================================================

// Mapeamento do Servo
#define HARDWARE_MIN  60
#define HARDWARE_MAX  200
#define PI 3.14159265
#define CENTER_X 160
#define CENTER_Y 239

int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

int main()
{
    alt_putstr("=== RADAR VGA (MODO MANUAL) ===\n");

    // Limpa a tela no inicio
    clear_screen();

    // Desenha uma borda branca só pra testar
    draw_line(0, 0, 319, 0, WHITE);
    draw_line(0, 0, 0, 239, WHITE);
    draw_line(319, 0, 319, 239, WHITE);

    int pos_virtual = 0;
    int direcao = 1;
    int pos_fisica = 0;
    int prev_x = CENTER_X, prev_y = CENTER_Y;

    while (1)
    {
        // 1. Apaga a linha antiga (desenha preto em cima)
        draw_line(CENTER_X, CENTER_Y, prev_x, prev_y, BLACK);

        // 2. Move Servo
        pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);
        usleep(20000);

        // 3. Lê Sensor
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF;
        if (dist_cm > 150) dist_cm = 150;

        // 4. Calcula Posição (Polar -> Cartesiano)
        float angulo_rad = ((float)pos_virtual / 255.0) * PI;

        // Linha do Scanner (Comprimento fixo 200px)
        int scan_len = 200;
        int scan_x = CENTER_X - (int)(scan_len * cos(angulo_rad));
        int scan_y = CENTER_Y - (int)(scan_len * sin(angulo_rad));

        // Ponto do Obstáculo
        int obst_x = CENTER_X - (int)(dist_cm * 1.5 * cos(angulo_rad));
        int obst_y = CENTER_Y - (int)(dist_cm * 1.5 * sin(angulo_rad));

        // 5. Desenha Nova Linha (Verde)
        draw_line(CENTER_X, CENTER_Y, scan_x, scan_y, GREEN);

        // 6. Desenha Obstáculo (Vermelho) se estiver perto
        if (dist_cm < 100 && dist_cm > 2) {
            // Desenha um "X" ou ponto gordo
            plot_pixel(obst_x, obst_y, RED);
            plot_pixel(obst_x+1, obst_y, RED);
            plot_pixel(obst_x, obst_y+1, RED);
            plot_pixel(obst_x+1, obst_y+1, RED);
        }

        prev_x = scan_x;
        prev_y = scan_y;

        // Atualiza Loop
        pos_virtual += direcao * 4;
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
