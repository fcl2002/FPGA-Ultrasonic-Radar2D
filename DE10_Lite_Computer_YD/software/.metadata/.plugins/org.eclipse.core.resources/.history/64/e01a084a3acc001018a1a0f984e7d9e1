#include <stdint.h>
#include <stdio.h>
#include <unistd.h>
#include "system.h"
#include "io.h"

int main()
{
    printf("==== Telemetre Ultrasonique DE10-Lite ====\n");

    while (1)
    {
        // Ler distância da IP Avalon
        int dist = IORD_32DIRECT(TELEMETRE_US_AVALON_0_BASE, 0);

        // Sanitização dos valores
        if (dist < 0) dist = 0;
        if (dist > 400) dist = 400;

        // Mostrar no terminal UART
        printf("Distance mesuree : %d cm\n", dist);

        // Atualiza a cada 100 ms
        usleep(100000);
    }

    return 0;
}
