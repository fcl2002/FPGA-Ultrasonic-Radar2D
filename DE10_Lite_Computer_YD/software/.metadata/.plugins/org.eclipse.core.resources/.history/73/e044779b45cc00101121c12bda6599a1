#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include "io.h"     // IORD
#include "system.h" // Base address definitions


static const unsigned char SEG_MAP[10] =
{
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F  // 9
};

// Função para escrever nos 4 displays
void write_sevenseg(int dist)
{
    if (dist < 0) dist = 0;
    if (dist > 9999) dist = 9999;

    int d0 = (dist / 1)   % 10;
    int d1 = (dist / 10)  % 10;
    int d2 = (dist / 100) % 10;
    int d3 = (dist / 1000) % 10;

    unsigned int packed =
        (SEG_MAP[d0] << 0)  |
        (SEG_MAP[d1] << 8)  |
        (SEG_MAP[d2] << 16) |
        (SEG_MAP[d3] << 24);

    IOWR_32DIRECT(HEX3_HEX0_BASE, 0, packed);
}

int main()
{
    alt_putstr("=== Radar Ultrassonico - Teste 7 Segmentos ===\n");

    while (1)
    {

        alt_u32 data = IORD(TELEMETRE_US_AVALON_0_BASE, 0);

        int dist_hardware = data & 0x3FF;   // primeiros 10 bits
        int raw_cycles    = data >> 10;     // debug opcional

        // Correção necessária (50 MHz → dobra a distância)
        dist_hardware = dist_hardware / 2;

        // Exibe no console
        printf("Dist : %d cm \n", dist_hardware);

        // Exibe no display de 7 segmentos
        write_sevenseg(dist_hardware);

        usleep(200000); // 200 ms
    }

    return 0;
}
