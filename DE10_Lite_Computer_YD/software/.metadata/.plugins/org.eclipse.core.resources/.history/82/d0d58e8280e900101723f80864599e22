#include <stdint.h>
#include <stdio.h>
#include <unistd.h>
#include "system.h"
#include "io.h"

/* =========================
   UART Avalon "friend style"
   - Single 32-bit register at offset 0
   - Pseudo-address encoded in writedata[31:30]
     00: LOAD   (bit0)
     01: TX     (bits 7:0)
     10: RX     (read returns bits 7:0)
   ========================= */

/* Try to auto-pick the UART base symbol generated by Platform Designer */
#if defined(IP_UART_AVALON_0_BASE)
  #define UART_BASE_ADDR IP_UART_AVALON_0_BASE
#elif defined(IP_UART_AVALON_BASE)
  #define UART_BASE_ADDR IP_UART_AVALON_BASE
#elif defined(UART_EXTERNAL_BASE)
  #define UART_BASE_ADDR UART_EXTERNAL_BASE
#else
  #error "UART base address not found. Check system.h for your UART peripheral BASE."
#endif

/* Address codes (writedata[31:30]) */
#define UART_A_LOAD  (0u)
#define UART_A_TX    (1u)
#define UART_A_RX    (2u)

/* Pack command word: [31:30]=addr, [7:0]=payload for TX, bit0 for LOAD */
static inline uint32_t uart_pack(uint32_t addr2b, uint32_t payload)
{
    return ((addr2b & 0x3u) << 30) | (payload & 0x3FFFFFFFu);
}

static inline void uart_write_word(uint32_t w)
{
    IOWR(UART_BASE_ADDR, 0, w);
}

static inline uint32_t uart_read_word(void)
{
    return IORD(UART_BASE_ADDR, 0);
}

/* Delay helper: keep LOAD asserted long enough to be seen by the UART FSM Tick */
static void uart_short_delay_us(int us)
{
    /* usleep is available in Nios II newlib; keep small and deterministic */
    usleep(us);
}

/* Send one byte */
static void uart_putc(uint8_t c)
{
    /* Write TX byte */
    uart_write_word(uart_pack(UART_A_TX, (uint32_t)c));

    /* Assert LOAD = 1 (must stay high long enough until the UART Tick catches it) */
    uart_write_word(uart_pack(UART_A_LOAD, 1u));
    uart_short_delay_us(50);   /* > 1 bit time at 115200 (~8.68 us); 50 us is safe */

    /* Deassert LOAD = 0 */
    uart_write_word(uart_pack(UART_A_LOAD, 0u));
    uart_short_delay_us(50);
}

/* Send string */
static void uart_puts(const char *s)
{
    while (*s) {
        uart_putc((uint8_t)*s++);
    }
}

/* Read last RX byte (no rx_ready flag exists in this design) */
static uint8_t uart_read_rx_raw(void)
{
    /* Ensure pseudo-address is set to RX before reading */
    uart_write_word(uart_pack(UART_A_RX, 0u));
    return (uint8_t)(uart_read_word() & 0xFFu);
}

/* Blocking "getc" by change-detection (limitation: repeated same char may be missed) */
static uint8_t uart_getc_blocking(void)
{
    static uint8_t last = 0;
    uint8_t b;

    do {
        b = uart_read_rx_raw();
    } while (b == last);

    last = b;
    return b;
}

static void print_help(void)
{
    uart_puts("\r\nCommands:\r\n");
    uart_puts("  h : help\r\n");
    uart_puts("  p : ping\r\n");
    uart_puts("  Any other key -> echo back\r\n\r\n");
}

int main(void)
{
    uart_puts("\r\n=== UART Custom Test (115200 8N1) ===\r\n");
    uart_puts("Type on VS Code terminal and FPGA will echo.\r\n");
    uart_puts("Press 'h' for help.\r\n\r\n");

    while (1) {
        uint8_t c = uart_getc_blocking();

        if (c == 'h' || c == 'H') {
            print_help();
        } else if (c == 'p' || c == 'P') {
            uart_puts("\r\nPONG\r\n");
        } else if (c == '\r' || c == '\n') {
            uart_puts("\r\n");
        } else {
            /* Echo */
            uart_putc(c);
        }
    }

    return 0;
}






