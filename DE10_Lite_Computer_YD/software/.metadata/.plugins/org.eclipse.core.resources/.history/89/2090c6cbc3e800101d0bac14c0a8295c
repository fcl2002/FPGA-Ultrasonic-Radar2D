#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include "system.h"
#include "io.h"
#include "alt_types.h"
#include "altera_up_avalon_video_dma_controller.h"

// ==========================================
// CONFIGURAÇÕES
// ==========================================
// Endereço base da memória de texto (Verifique system.h se der erro)
#define CHAR_BUF_BASE VGA_SUBSYSTEM_CHAR_BUF_SUBSYSTEM_ONCHIP_SRAM_BASE

#define SCREEN_WIDTH 320
#define SCREEN_HEIGHT 240
#define RADAR_CENTER_X 160
#define RADAR_CENTER_Y 239
#define MAX_RADIUS 220
#define PI 3.14159265

// Cores (RGB 565)
#define COLOR_BLACK 0x0000
#define COLOR_WHITE 0xFFFF
#define COLOR_GREEN 0x07E0
#define COLOR_RED   0xF800
#define COLOR_BLUE  0x001F

// Variável global
alt_up_video_dma_dev *pixel_dma_dev;

// ==========================================
// FUNÇÕES DE TEXTO (MANUAL)
// ==========================================
void vga_clear_text() {
    int x, y;
    for (y = 0; y < 60; y++) {
        for (x = 0; x < 80; x++) {
            unsigned int offset = (y << 7) + x;
            IOWR_8DIRECT(CHAR_BUF_BASE, offset, ' ');
        }
    }
}

void vga_write_text(int x, int y, char *text_ptr) {
    unsigned int offset = (y << 7) + x;
    while (*text_ptr) {
        IOWR_8DIRECT(CHAR_BUF_BASE, offset, *text_ptr);
        text_ptr++;
        offset++;
    }
}

// ==========================================
// FUNÇÕES GRÁFICAS (CORRIGIDAS)
// ==========================================

void init_vga() {
    // Abre o dispositivo
    pixel_dma_dev = alt_up_video_dma_open_dev("/dev/VGA_Subsystem_VGA_Pixel_DMA");

    if (pixel_dma_dev == NULL) {
        printf("ERRO: Nao foi possivel abrir o dispositivo VGA Pixel DMA.\n");
    } else {
        // Limpa a tela
        alt_up_video_dma_screen_clear(pixel_dma_dev, 0);

        // Desenha a grade fixa
        // CORREÇÃO: A cor (COLOR_WHITE) vem ANTES das coordenadas neste driver
        alt_up_video_dma_draw_line(pixel_dma_dev, COLOR_WHITE, RADAR_CENTER_X, RADAR_CENTER_Y, RADAR_CENTER_X, 20, 0);
        alt_up_video_dma_draw_line(pixel_dma_dev, COLOR_WHITE, 10, RADAR_CENTER_Y, 310, RADAR_CENTER_Y, 0);
    }

    // Inicializa texto
    vga_clear_text();
    vga_write_text(32, 2, "RADAR ULTRASSONICO");
    vga_write_text(2, 55, "Distancia:");
    vga_write_text(2, 57, "Angulo   :");

    printf("VGA Inicializado.\n");
}

void update_radar_view(int angle_deg, int distance_cm) {
    static int old_x = RADAR_CENTER_X;
    static int old_y = RADAR_CENTER_Y;
    static int last_dist = -1;
    static int last_ang = -1;
    char buf[20];

    if (pixel_dma_dev == NULL) return;

    // --- 1. Calcular Coordenadas ---
    double rad = (double)angle_deg * PI / 180.0;
    int x_sweep = RADAR_CENTER_X + (int)(MAX_RADIUS * cos(rad));
    int y_sweep = RADAR_CENTER_Y - (int)(MAX_RADIUS * sin(rad));

    // --- 2. Desenhar Linhas (Sweep) ---

    // Apagar linha antiga (Desenha Preto)
    // Assinatura: (dev, COR, x0, y0, x1, y1, buffer)
    alt_up_video_dma_draw_line(pixel_dma_dev, COLOR_BLACK, RADAR_CENTER_X, RADAR_CENTER_Y, old_x, old_y, 0);

    // Desenhar linha nova (Desenha Verde)
    alt_up_video_dma_draw_line(pixel_dma_dev, COLOR_GREEN, RADAR_CENTER_X, RADAR_CENTER_Y, x_sweep, y_sweep, 0);

    old_x = x_sweep;
    old_y = y_sweep;

    // --- 3. Desenhar Objeto ---
    if (distance_cm > 0 && distance_cm < MAX_RADIUS) {
        int dist_px = distance_cm; // 1cm = 1px

        int x_obj = RADAR_CENTER_X + (int)(dist_px * cos(rad));
        int y_obj = RADAR_CENTER_Y - (int)(dist_px * sin(rad));

        // CORREÇÃO AQUI:
        // Assinatura: (dev, COR, x0, y0, x1, y1, buffer, fill)
        // fill = 1 (preencher a caixa)
        alt_up_video_dma_draw_box(pixel_dma_dev, COLOR_RED, x_obj-1, y_obj-1, x_obj+1, y_obj+1, 0, 1);
    }

    // --- 4. Atualizar Texto ---
    if (abs(distance_cm - last_dist) > 0) {
        if (distance_cm > 400 || distance_cm < 0) sprintf(buf, "--- cm");
        else sprintf(buf, "%3d cm", distance_cm);
        vga_write_text(13, 55, buf);
        last_dist = distance_cm;
    }

    if (angle_deg != last_ang) {
        sprintf(buf, "%3d deg", angle_deg);
        vga_write_text(13, 57, buf);
        last_ang = angle_deg;
    }
}
