#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include "io.h"
#include "system.h"

// Seus nomes (confira system.h)
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// Limites de segurança do Servo (Mantendo o que funcionou)
#define HARDWARE_MIN  5
#define HARDWARE_MAX  245

// Função de Mapeamento (Segurança do Servo)
int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

int main()
{
    alt_putstr("=== RADAR FINAL (MODO HARDWARE) ===\n");

    int pos_virtual = 0;
    int direcao = 1;
    int pos_fisica = 0;

    while (1)
    {
        // --- 1. MOVIMENTAÇÃO DO SERVO (Lógica Segura) ---
        pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);

        // Delay para o servo chegar e o sensor estabilizar
        usleep(50000); // 50ms é um bom tempo seguro

        // --- 2. LEITURA DO SENSOR (Igual aos LEDs) ---

        // Lê os 32 bits do IP
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);

        // MÁGICA AQUI: Em vez de calcular float, pegamos o valor pronto
        // Mascara 0x3FF pega apenas os 10 primeiros bits (0 a 1023)
        // Isso é EXATAMENTE o que está sendo enviado para os LEDs
        int dist_hardware = radar_data & 0x3FF;

        // Filtro simples para sujeira (se for 0 ou maximo, ignora ou trata)
        if (dist_hardware > 400) dist_hardware = 400;

        // --- 3. IMPRESSÃO ---
        // Formato CSV: ANGULO, DISTANCIA
        printf("%d,%d\n", pos_virtual, dist_hardware);

        // --- 4. CONTROLE DA VARREDURA ---
        pos_virtual += direcao * 2; // Passo de 2 em 2

        if (pos_virtual >= 255) {
            direcao = -1;
        } else if (pos_virtual <= 0) {
            direcao = 1;
        }
    }

    return 0;
}
