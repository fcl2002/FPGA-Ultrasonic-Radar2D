#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include "io.h"
#include "system.h"

// Seus nomes (confira system.h)
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// Limites de segurança do Servo
#define HARDWARE_MIN  60
#define HARDWARE_MAX  200

// Função de Mapeamento
int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

int main()
{
    alt_putstr("=== LEITURA DE DISTANCIA ===\n");

    int pos_virtual = 0;
    int direcao = 1;
    int pos_fisica = 0;

    while (1)
    {
        // --- 1. MOVIMENTAÇÃO DO SERVO (Continua varrendo em silêncio) ---
        pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);

        usleep(50000); // 50ms

        // --- 2. LEITURA DO SENSOR ---
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);

        // Pega os bits 0-9 (Valor igual aos LEDs)
        int dist_cm = radar_data & 0x3FF;

        // Limita visualmente a 400cm (alcance máx do sensor)
        if (dist_cm > 400) dist_cm = 400;

        // --- 3. IMPRESSÃO LIMPA ---
        // AQUI ESTÁ A MUDANÇA: Imprime só o número e "cm"
        printf("%d cm\n", dist_cm);

        // --- 4. ATUALIZA POSIÇÃO ---
        pos_virtual += direcao * 2;

        if (pos_virtual >= 255) {
            direcao = -1;
        } else if (pos_virtual <= 0) {
            direcao = 1;
        }
    }

    return 0;
}
