#include "sys/alt_stdio.h"
#include <stdio.h>
#include <unistd.h>
#include <math.h>
#include <stdlib.h>
#include "io.h"
#include "system.h"

// Inclusions pour piloter le sous-système VGA proprement
#include "altera_up_avalon_video_pixel_buffer_dma.h"
#include "altera_up_avalon_video_character_buffer_with_dma.h"

// ============================================================================
// CONFIGURATIONS IP
// ============================================================================
#define SERVO_BASE      IP_SERVO_AVALON_0_BASE
#define TELEMETRE_BASE  TELEMETRE_US_AVALON_0_BASE

// Variables globales pour le VGA
alt_up_pixel_buffer_dma_dev* pixel_buffer_dev;
unsigned int pixel_buffer_addr; // On stockera l'adresse réelle ici

// Couleurs (Format 16-bit RGB 565)
#define WHITE 0xFFFF
#define BLACK 0x0000
#define GREEN 0x07E0
#define RED   0xF800

// ============================================================================
// FONCTIONS GRAPHIQUES
// ============================================================================

// Initialisation du VGA via les drivers Altera
// Retourne 0 si succès, -1 si échec
int init_vga() {
    // 1. Ouvrir le périphérique Pixel Buffer
    pixel_buffer_dev = alt_up_pixel_buffer_dma_open_dev("/dev/VGA_Subsystem_VGA_Pixel_DMA");
    if (pixel_buffer_dev == NULL) {
        alt_printf("Erreur: Impossible d'ouvrir le Pixel Buffer DMA\n");
        return -1;
    }

    // 2. Nettoyer l'écran
    alt_up_pixel_buffer_dma_clear_screen(pixel_buffer_dev, 0);

    // 3. Récupérer l'adresse mémoire où dessiner (Back Buffer)
    // C'est l'étape cruciale : le système nous donne la bonne adresse (ex: 0xC8000000)
    pixel_buffer_addr = pixel_buffer_dev->buffer_start_address;

    alt_printf("VGA Initialise. Adresse Memoire Video: 0x%x\n", pixel_buffer_addr);
    return 0;
}

// Version optimisée et sécurisée de plot_pixel
void plot_pixel(int x, int y, short color) {
    if (x < 0 || x >= 320 || y < 0 || y >= 240) return;

    // Calcul de l'adresse : Base + Offset
    // Les contrôleurs VGA Altera utilisent souvent un alignement de 1024 octets (x << 1)
    // ou une linéarité simple (x * 2).
    // Méthode générique via le driver (un peu plus lente mais sûre) :
    // alt_up_pixel_buffer_dma_draw(pixel_buffer_dev, color, x, y);

    // Méthode rapide (écriture directe) :
    // On suppose ici une résolution 320x240 avec adressage linéaire standard
    int offset = (y * 320 + x) * 2;
    IOWR_16DIRECT(pixel_buffer_addr, offset, color);
}

void draw_line(int x0, int y0, int x1, int y1, short color) {
    int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
    int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
    int err = dx + dy, e2;

    while (1) {
        plot_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
    }
}

void clear_screen() {
    // On peut utiliser la fonction hardware qui est très rapide
    alt_up_pixel_buffer_dma_clear_screen(pixel_buffer_dev, 0);
}

// ============================================================================
// MAIN
// ============================================================================
#define HARDWARE_MIN  60    // Valeur servo min (environ 0 deg)
#define HARDWARE_MAX  200   // Valeur servo max (environ 180 deg)
#define PI 3.14159265
#define CENTER_X 160
#define CENTER_Y 239

int map_range(int x) {
    return HARDWARE_MIN + (x * (HARDWARE_MAX - HARDWARE_MIN) / 255);
}

int main()
{
    alt_putstr("=== RADAR VGA (ETAPE 4) ===\n");

    // 1. Initialiser le VGA
    if (init_vga() != 0) return 0;

    // Test rapide : Dessiner les bordures
    draw_line(0, 0, 319, 0, WHITE);
    draw_line(0, 0, 0, 239, WHITE);
    draw_line(319, 0, 319, 239, WHITE);

    // Test texte (optionnel, si vous voulez afficher la distance en texte)
    alt_up_char_buffer_dev *char_buf;
    char_buf = alt_up_char_buffer_open_dev("/dev/VGA_Subsystem_Char_Buf_Subsystem_Char_Buf_DMA");
    if(char_buf) {
        alt_up_char_buffer_string(char_buf, "RADAR SYSTEM", 35, 2);
    }

    int pos_virtual = 0;
    int direcao = 1;
    int pos_fisica = 0;

    // Variables pour effacer l'ancienne ligne
    int prev_x = CENTER_X;
    int prev_y = CENTER_Y;

    // Variables pour l'affichage de la distance en texte
    char msg_dist[20];

    while (1)
    {
        // --- 1. EFFACEMENT ---
        // On efface la ligne précédente en redessinant en NOIR
        draw_line(CENTER_X, CENTER_Y, prev_x, prev_y, BLACK);

        // --- 2. MOUVEMENT SERVO ---
        pos_fisica = map_range(pos_virtual);
        IOWR(SERVO_BASE, 0, pos_fisica);
        usleep(15000); // Petite pause pour laisser le servo bouger

        // --- 3. MESURE ---
        alt_u32 radar_data = IORD(TELEMETRE_BASE, 0);
        int dist_cm = radar_data & 0x3FF;

        // Limite visuelle pour l'écran (ex: max 100cm affichés)
        if (dist_cm > 100) dist_cm = 100;

        // --- 4. CALCULS ---
        float angulo_rad = ((float)pos_virtual / 255.0) * PI; // 0 à PI

        // Coordonnées du bout de la ligne de scan (rayon fixe)
        int scan_len = 220;
        int scan_x = CENTER_X - (int)(scan_len * cos(angulo_rad));
        int scan_y = CENTER_Y - (int)(scan_len * sin(angulo_rad));

        // Coordonnées de l'obstacle
        // Facteur 2.0 pour "zoomer" : 1cm réel = 2 pixels écran
        int obst_x = CENTER_X - (int)(dist_cm * 2.2 * cos(angulo_rad));
        int obst_y = CENTER_Y - (int)(dist_cm * 2.2 * sin(angulo_rad));

        // --- 5. DESSIN ---
        // Ligne de balayage (verte)
        draw_line(CENTER_X, CENTER_Y, scan_x, scan_y, GREEN);

        // Obstacle (rouge) - Seulement si un objet est détecté (ex: > 4cm)
        if (dist_cm < 90 && dist_cm > 4) {
            // Dessine un petit carré rouge
            plot_pixel(obst_x, obst_y, RED);
            plot_pixel(obst_x+1, obst_y, RED);
            plot_pixel(obst_x, obst_y+1, RED);
            plot_pixel(obst_x+1, obst_y+1, RED);
        }

        // Affichage texte (optionnel)
        if(char_buf && pos_virtual % 10 == 0) { // Update texte moins souvent
            sprintf(msg_dist, "Dist: %d cm ", dist_cm);
            alt_up_char_buffer_string(char_buf, msg_dist, 2, 58); // En bas à gauche
        }

        // Sauvegarde pour le prochain tour
        prev_x = scan_x;
        prev_y = scan_y;

        // Mise à jour boucle
        pos_virtual += direcao * 3; // Vitesse de rotation
        if (pos_virtual >= 255) direcao = -1;
        else if (pos_virtual <= 0) direcao = 1;
    }

    return 0;
}
